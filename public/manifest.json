{
    "manifest_version": 3,
    "name": "InjectCode2",
    "description": "Store and inject code to browser pages made super easy.",
    "minimum_chrome_version": "138",
    "version": "2.0.0",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/inject16.png",
            "32": "icons/inject32.png",
            "48": "icons/inject48.png",
            "128": "icons/inject128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions" : [
        "tabs",
        "activeTab",
        "storage",
        "scripting",
        "userScripts"
    ],
    "host_permissions": ["<all_urls>"],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "icons": {
        "16": "icons/inject16.png",
        "32": "icons/inject32.png",
        "48": "icons/inject48.png",
        "128": "icons/inject128.png"
    }
}
